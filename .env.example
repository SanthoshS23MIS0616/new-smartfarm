# SmartFarm Platform Environment Configuration
# Copy this file to .env and fill in your keys (all keys are optional; the platform has full offline/deterministic fallbacks)

# ── 1. LLM Grounded Assistant (Choose one or both) ───────────────────────────
# Groq is 100% free with fast Llama-3.3-70B: Get key at https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini API Key: Get free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── 2. WhatsApp / SMS / IVR Voice Call Gateway (Optional) ────────────────────
# Twilio credentials for physical cellular SMS & automated telephone calls
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
